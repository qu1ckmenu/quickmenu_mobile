<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvQuickMenuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_menu"
            android:textColor="#F5B400"
            android:textSize="35sp"
            android:textStyle="bold"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvCadastroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadastro"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvCadastroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preencha_com_seus_dados_para_realizar_o_cadastro"
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etNomeUsuario"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/nome_de_usu_rio"
            android:inputType="textPersonName"
            android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:layout_marginBottom="12dp"
            android:textColor="#333333"
            android:textColorHint="#AAAAAA" />

        <EditText
            android:id="@+id/etEmailCadastro"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/email_gmail_com"
            android:inputType="textEmailAddress"
            android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:layout_marginBottom="12dp"
            android:textColor="#333333"
            android:textColorHint="#AAAAAA" />

        <EditText
            android:id="@+id/etSenhaCadastro"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/senha"
            android:inputType="textPassword"
            android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:layout_marginBottom="32dp"
            android:textColor="#333333"
            android:textColorHint="#AAAAAA" />

        <Button
            android:id="@+id/btnCadastrarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cadastrar_usu_rio"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F5B400"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="40dp"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/tvTermos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ao_continuar_voc_concorda_com_nossos_termos_de_servi_o_e_pol_tica_de_privacidade"
            android:textColor="#999999"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:visibility="invisible"
            tools:visibility="visible"
            style="?android:attr/progressBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
